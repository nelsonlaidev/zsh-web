{
  "name": "zsh-web",
  "version": "0.0.0",
  "license": "MIT",
  "author": "Nelson Lai <me@nelsonlai.dev> (https://github.com/nelsonlaidev/)",
  "type": "module",
  "scripts": {
    "build": "next build --turbo",
    "check": "bun lint && bun typecheck && bun format:check && bun knip",
    "clean": "rm -rf .next",
    "dev": "next dev --turbo",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "lefthook install",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@t3-oss/env-nextjs": "^0.13.11",
    "@zenfs/core": "^2.7.3",
    "@zenfs/dom": "^1.2.14",
    "arg": "^5.0.2",
    "cn": "^0.2.6",
    "dayjs": "^1.11.23",
    "kerium": "^1.5.0",
    "next": "16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uid": "^2.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.19.0",
    "@nelsonlaidev/oxfmt-config": "^0.3.1",
    "@nelsonlaidev/oxlint-config": "^1.1.0",
    "@nelsonlaidev/typescript-config": "^1.2.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "knip": "^6.35.1",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.2"
}
